# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 = mejor criterio. claude-haiku-5-5 = ~40x mas barato.
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Google (Gmail solo-lectura + Calendar) ----------
# Se obtienen corriendo: python scripts/google_oauth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Permiso de Calendar. El de abajo es el chico: el agente solo puede tocar
# los calendarios que crea el. Si diera problemas, el ancho es:
#   https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.app.created

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Se completa solo cuando le mandes /start al bot; o ponelo a mano.
TELEGRAM_CHAT_ID=
# Inventa una cadena larga al azar; valida que el webhook venga de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# ---------- App ----------
TIMEZONE=America/Argentina/Buenos_Aires
DATABASE_URL=sqlite:///./data/agent.db
POLL_INTERVAL_MINUTES=15
# Cuantos dias hacia atras mirar en el primer arranque
INITIAL_LOOKBACK_DAYS=14
# Hora local a la que manda el resumen y los recordatorios
DAILY_DIGEST_HOUR=9
# URL publica del servicio (para registrar el webhook de Telegram)
PUBLIC_URL=
